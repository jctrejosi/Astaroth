# ══════════════════════════════════════════════════════════════════
# Astaroth — variables de entorno
# Copia como .env (local) o decláralas en tu plataforma
# (Render/Railway/VPS) según render.yaml. El entrypoint pasa las
# mismas variables a los 5 servicios; cada uno lee solo las suyas.
# ══════════════════════════════════════════════════════════════════

# ── Proxy (docker-entrypoint.sh / Caddy) ──────────────────────────
# Puerto público. Render lo inyecta automáticamente; default 10000.
PORT=10000

# ── Seguridad ─────────────────────────────────────────────────────
# Clave de admin COMPARTIDA por todos los servicios. Protege los
# /admin/* (borrado de modelos) y los endpoints de entrenamiento y
# asignación: /fit-from-db y /assign-from-db (header X-Admin-Key).
# ⚠️ Obligatoria en producción — no dejes el default "change-me".
ADMIN_KEY=change-me

# ── Claves de API (APIs públicas) ─────────────────────────────────
# Todas las rutas —salvo /health— exigen una clave válida, ya sea como
# cabecera `X-API-Key: <clave>` o `Authorization: Bearer <clave>`.
# Separa varias claves con comas para poder revocar una sin tocar a los demás
# clientes. Genera cada clave con: openssl rand -hex 32
# ⚠️ Si API_AUTH_REQUIRED=1 y API_KEYS está vacío, la API responde 503
#    (no queda abierta).
API_KEYS=
API_AUTH_REQUIRED=1
# 1 = deja /docs, /redoc y /openapi.json sin clave (solo el esquema).
API_PUBLIC_DOCS=0

# ── Base de datos de analytics (clustering-api) ───────────────────
# Réplica Postgres que alimenta la segmentación (lee la vista
# analytics.vw_rfm_clientes). Sin esto, /fit-from-db y
# /assign-from-db responden 503. En producción apunta al Postgres de
# analytics (VPS/managed), NO a la BD transaccional del ecommerce.
# Con Docker, "localhost" es el propio contenedor: si el Postgres está en el
# host usa host.docker.internal (p. ej. ...@host.docker.internal:5436/analytics).
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/analytics

# ── Persistencia de modelos (opcional) ────────────────────────────
# Directorio donde cada servicio guarda lo entrenado
# (model.joblib + centroids.json + metadata.json).
# ⚠️ En producción monta aquí un volumen persistente (Render Disk /
# Railway Volume): los contenedores son efímeros y los modelos no van
# en la imagen (saved_models/ está dockerignored).
MODELS_DIR=saved_models

# ── Docker Compose (servidor compartido) ──────────────────────────
# 0 = solo el trío ligero (clustering/xgboost/uplift/highs).
# 1 = arranca también transformer (8013) y causal (8014).
ASTROTH_FULL=1

# Interfaz del host donde se publican los puertos. Usa 127.0.0.1 si un edge
# (Caddy/nginx) hará el proxy; 0.0.0.0 para acceso directo.
ASTAROTH_BIND_IP=0.0.0.0

# Puertos del host. 8010-8015 están reservados para Astaroth y no chocan
# con ecommerce (30180/30181), CRM (30280/30281), Paimon (8100/8101/8102)
# ni el bot de WhatsApp (8300/8301).
ASTAROTH_CLUSTERING_PORT=8010
ASTAROTH_XGBOOST_PORT=8011
ASTAROTH_UPLIFT_PORT=8012
ASTAROTH_TRANSFORMER_PORT=8013
ASTAROTH_CAUSAL_PORT=8014
ASTAROTH_HIGHS_PORT=8015
