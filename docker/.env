# ══════════════════════════════════════════════════════════════
# Astaroth — contenedor único (docker/) — variables de entorno
# Plantilla:  cp docker/.env.example docker/.env
# `node prod.js` sincroniza HOST_ML/TLS/puertos desde prod.config.json (sin
# pisar secretos) y `node scripts-agent/set-prod-secrets.mjs` genera ADMIN_KEY.
# ══════════════════════════════════════════════════════════════

# ── Dominio del API ML ────────────────────────────────────────
HOST_ML=ml.mercaldas.jcti.xyz

# ── Seguridad ─────────────────────────────────────────────────
# Clave compartida por los 5 servicios (header X-Admin-Key). Protege
# /admin/* (borrado de modelos), /fit*, /assign*… El contenedor NO arranca si
# queda vacía o en "change-me".
# ⚠️ Debe ser IDÉNTICA al CLUSTERING_API_KEY del CRM (él la envía en sus
#    llamadas a clustering-api).
ADMIN_KEY=f7aa76207080d121e2ca55c6d6aedb7aa01000459fd15c79d0ec6a794a17c6ec

# ── Proxy / TLS ───────────────────────────────────────────────
# Modo directo (servidor dedicado): el contenedor publica 80/443 y emite el
# TLS de HOST_ML con Let's Encrypt.
TLS=false
ACME_EMAIL=admin@jcti.xyz
PUBLIC_HTTP_PORT=127.0.0.1:30380
PUBLIC_HTTPS_PORT=127.0.0.1:30381

# ── Variante de imagen ────────────────────────────────────────
# lite = clustering+xgboost+uplift · full = + transformer + causal (PyTorch;
# necesita ≥8 GB de RAM). prod.js lo sincroniza desde "withPyTorch".
BUILD_TARGET=lite
# Arranca además los 2 servicios PyTorch (solo tiene efecto con BUILD_TARGET=full)
ASTROTH_FULL=0

# ── Límites ───────────────────────────────────────────────────
# Tamaño máximo de cuerpo HTTP (los /fit reciben datasets JSON). 0 = sin límite.
MAX_REQUEST_BODY=100MB

# ── Base de datos de analytics (clustering) ───────────────────
# Réplica analytics del CRM: /fit-from-db y /assign-from-db leen la vista
# analytics.vw_rfm_clientes. Requiere conectar este contenedor a la red del CRM:
#   docker network connect crm_internal mercaldas_astaroth_app
# Sin esa red, esos dos endpoints fallan; el resto funciona igual.
DATABASE_URL=postgresql://postgres:postgres@analytics-postgres:5432/analytics

# ── Modo EDGE compartido (recomendado si el servidor tiene más proyectos) ──
# El edge (ecommerce/docker/edge/) publica 80/443 y hace TLS; este contenedor
# queda en loopback con sus puertos propios. prod.js con "mode": "edge" lo
# sincroniza solo; descomenta estas líneas si editas el .env a mano:
#TLS=false
ALLOW_INSECURE=true
#PUBLIC_HTTP_PORT=127.0.0.1:30380
#PUBLIC_HTTPS_PORT=127.0.0.1:30381
