# Caddyfile — modo DIRECTO (TLS=true, servidor dedicado para Astaroth).
#
# Este contenedor publica 80/443 y emite el certificado de `HOST_ML` con
# Let's Encrypt (validación HTTP-01 en :{$HTTP_PORT}, que el compose publica
# como 80). Después sirve HTTPS y redirige HTTP→HTTPS.
#
# Placeholders de entorno (los fija docker/entrypoint.sh):
#   HOST_ML            dominio público (p. ej. ml.mercaldas.jcti.xyz)
#   ACME_EMAIL         email para Let's Encrypt (avisos de expiración)
#   HTTP_PORT / HTTPS_PORT   puertos internos (def. 8080 / 8443)
#   MAX_REQUEST_BODY   tamaño máximo de cuerpo (def. 100MB; 0 ⇒ sin límite)
{
	admin off
	http_port {$HTTP_PORT}
	https_port {$HTTPS_PORT}
	email {$ACME_EMAIL}
}

{$HOST_ML} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Los endpoints de ML reciben datasets JSON: se acota el cuerpo.
	request_body {
		max_size {$MAX_REQUEST_BODY}
	}

	encode zstd gzip

	# handle_path quita el prefijo antes de reenviar.
	handle_path /clustering/* {
		reverse_proxy 127.0.0.1:8010
	}

	handle_path /xgboost/* {
		reverse_proxy 127.0.0.1:8011
	}

	handle_path /uplift/* {
		reverse_proxy 127.0.0.1:8012
	}

	handle_path /transformer/* {
		reverse_proxy 127.0.0.1:8013
	}

	handle_path /causal/* {
		reverse_proxy 127.0.0.1:8014
	}

	handle {
		respond "Astaroth ML API — /clustering · /xgboost · /uplift · /transformer · /causal" 200
	}
}
